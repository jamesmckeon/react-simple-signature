{
  "name": "react-simple-signature",
  "version": "1.0.0",
  "private": false,
  "description": "A simple-as-it-gets React signature pad/cavas component.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamesmckeon/react-simple-signature.git"
  },
  "keywords": [
    "react",
    "react-component",
    "react-hook",
    "signature",
    "signature-pad",
