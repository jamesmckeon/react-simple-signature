    "scribble",
    "sign",
    "signing",
    "form",
    "form-input",
    "input",
    "field",
    "ui",
    "component",
    "widget"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts"
  ],
  "sideEffects": false,
  "prepublishOnly": "npm run lint && npm test -- --run && npm run build",
  "scripts": {
